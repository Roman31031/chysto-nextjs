export function RoomChecklist({ rooms }) {
  const [active, setActive] = useState(0);
  const [dir, setDir] = useState(1);
  const touchX = React.useRef(null);
  const room = rooms[active];

  const goTo = (i, direction) => {
    if (i < 0 || i >= rooms.length) return;
    setDir(direction);
    setActive(i);
  };

  const onTouchStart = (e) => { touchX.current = e.touches[0].clientX; };
  const onTouchEnd = (e) => {
    if (touchX.current === null) return;
    const delta = e.changedTouches[0].clientX - touchX.current;
    const THRESHOLD = 45;
    if (delta <= -THRESHOLD) goTo(active + 1, 1);      // swiped left -> next room
    else if (delta >= THRESHOLD) goTo(active - 1, -1);  // swiped right -> previous room
    touchX.current = null;
  };

  return (
    <div>
      <div className="flex gap-2 mb-4 overflow-x-auto no-scrollbar -mx-5 px-5 sm:mx-0 sm:px-0">
        {rooms.map((r, i) => (
          <button
            key={r.room}
            onClick={() => goTo(i, i > active ? 1 : -1)}
            className="px-4 py-2 rounded-full text-sm font-semibold flex items-center gap-1.5 flex-shrink-0 whitespace-nowrap"
            style={{ ...body, background: active === i ? C.ink : C.bgSoft, color: active === i ? C.bg : C.ink }}
          >
            <span>{r.emoji}</span> {r.room}
          </button>
        ))}
      </div>

      <div className="flex items-center justify-center gap-1.5 mb-4 sm:hidden">
        {rooms.map((r, i) => (
          <span key={r.room} className="rounded-full transition-all" style={{ width: active === i ? 16 : 6, height: 6, background: active === i ? C.iconVivid : C.bgSoft }} />
        ))}
      </div>

      <DecorativeFrame>
        <div
          onTouchStart={onTouchStart}
          onTouchEnd={onTouchEnd}
          className="relative overflow-hidden"
        >
          <div key={active} className="swipe-panel grid sm:grid-cols-2 gap-x-6 gap-y-2.5" style={{ "--swipe-from": dir > 0 ? "24px" : "-24px" }}>
            {room.items.map((item) => (
              <div key={item} className="flex items-start gap-2">
                <CheckCircle2 size={16} color={C.iconVivid} strokeWidth={2.25} className="mt-0.5 flex-shrink-0" />
                <span className="text-sm" style={{ ...body, color: C.inkSoft }}>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </DecorativeFrame>

      <p className="text-xs mt-4 flex items-center gap-1.5 sm:hidden" style={{ ...body, color: C.ash }}>
        <ArrowRight size={13} strokeWidth={2.25} /> гортайте вліво/вправо, щоб перемкнути кімнату
      </p>
    </div>
  );
}

function makeSpots(count, seed) {
  return Array.from({ length: count }).map((_, i) => ({
    left: ((i * seed + 17) % 90) + 3,
    top: ((i * (seed + 11) + 9) % 78) + 4,
    delay: (i * 0.55) % 4.5,
    dur: 3.2 + ((i * 7) % 5) * 0.5,
    scale: 0.6 + ((i * 13) % 6) * 0.1,
  }));
}

