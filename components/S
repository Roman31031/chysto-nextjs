export function ReceiptCalculator({ serviceId }) {
  const service = SERVICES.find((s) => s.id === serviceId) || SERVICES[0];
  const [area, setArea] = useState(service.areaDefault);
  const [level, setLevel] = useState(3);
  const [addons, setAddons] = useState([]);
  const [windowArea, setWindowArea] = useState(0);

  useEffect(() => {
    setArea(service.areaDefault);
    setLevel(3);
    setAddons([]);
    setWindowArea(0);
  }, [serviceId]);

  const toggleAddon = (id) => setAddons((a) => (a.includes(id) ? a.filter((x) => x !== id) : [...a, id]));
  const showWindowSlider = serviceId !== "vikna";

  const calc = useMemo(() => {
    const rate = rateForLevel(service, level);
    const raw = Math.round(area * rate);
    const base = Math.max(MIN_ORDER, raw);
    const addonsSum = addons.reduce((sum, id) => sum + (ADDONS.find((a) => a.id === id)?.price || 0), 0);
    const windowsSum = showWindowSlider ? Math.round(windowArea * WINDOW_ADDON_RATE) : 0;
    const total = base + addonsSum + windowsSum;
    return { rate, raw, base, addonsSum, windowsSum, total, isMinApplied: raw < MIN_ORDER };
  }, [service, area, level, addons, windowArea, showWindowSlider]);

  return (
    <div className="rounded-2xl overflow-hidden" style={{ background: C.white }}>
      <div className="p-6 pb-4 flex items-center gap-2" style={{ background: C.ink }}><Calculator size={18} color={C.lemon} strokeWidth={2.25} /><span className="text-sm font-semibold" style={{ ...body, color: C.bg }}>Орієнтовний розрахунок</span></div>
      <div className="p-6">
        <label className="flex justify-between text-xs uppercase tracking-wide mb-2" style={{ ...body, color: C.ash }}><span>Площа</span><span style={mono}>{area} {service.unit}</span></label>
        <input type="range" min={service.areaMin} max={service.areaMax} value={area} onChange={(e) => setArea(Number(e.target.value))} className="range-slider w-full mb-6" />
        <label className="block text-xs uppercase tracking-wide mb-2" style={{ ...body, color: C.ash }}>Оцініть ступінь забруднення (1 — легке, 5 — сильне)</label>
        <div className="flex gap-2 mb-6">
          {[1, 2, 3, 4, 5].map((lv) => (
            <button key={lv} onClick={() => setLevel(lv)} className="flex-1 py-2.5 rounded-lg text-sm font-semibold" style={{ ...mono, background: level === lv ? C.lemon : C.bgSoft, color: C.ink }}>{lv}</button>
          ))}
        </div>
        <label className="block text-xs uppercase tracking-wide mb-2" style={{ ...body, color: C.ash }}>Додаткові послуги (за потреби)</label>
        <div className="flex flex-col gap-1.5 mb-2">
          {ADDONS.map((a) => (
            <label key={a.id} className="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer" style={{ background: addons.includes(a.id) ? C.mintSoft : C.bgSoft }}>
              <span className="flex items-center gap-2 text-sm" style={{ ...body, color: C.ink }}>
                <input type="checkbox" checked={addons.includes(a.id)} onChange={() => toggleAddon(a.id)} className="w-4 h-4" style={{ accentColor: C.mint }} />
                {a.label}
              </span>
              <span style={{ ...mono, fontSize: 13, color: C.inkSoft }}>+{a.price} ₴</span>
            </label>
          ))}
        </div>
        {showWindowSlider && (
          <>
            <label className="flex justify-between text-xs uppercase tracking-wide mb-2 mt-4" style={{ ...body, color: C.ash }}><span>Миття вікон (додатково)</span><span style={mono}>{windowArea} м²</span></label>
            <input type="range" min={0} max={30} value={windowArea} onChange={(e) => setWindowArea(Number(e.target.value))} className="range-slider w-full mb-1" />
            <p className="text-xs mb-2" style={{ ...body, color: C.ash }}>{WINDOW_ADDON_RATE} ₴/м² скління (рама, відкоси, скло без розводів)</p>
          </>
        )}
        <p className="text-xs mb-6 flex items-start gap-1.5" style={{ ...body, color: C.ash }}><Info size={13} className="mt-0.5 flex-shrink-0" /> це орієнтир для вас і для нас — остаточну оцінку узгодить майстер на місці</p>
        <div className="border-t pt-4" style={{ borderColor: C.bgSoft }}>
          <div className="flex justify-between text-sm mb-1.5" style={{ ...mono, color: C.ash }}><span>{area} {service.unit} × {calc.rate} ₴</span><span>{calc.raw} ₴</span></div>
          {calc.isMinApplied && <div className="flex justify-between text-sm mb-1.5" style={{ ...mono, color: C.ash }}><span>мінімальна сума замовлення</span><span>{MIN_ORDER} ₴</span></div>}
          {calc.addonsSum > 0 && <div className="flex justify-between text-sm mb-1.5" style={{ ...mono, color: C.ash }}><span>додаткові послуги</span><span>+{calc.addonsSum} ₴</span></div>}
          {calc.windowsSum > 0 && <div className="flex justify-between text-sm mb-1.5" style={{ ...mono, color: C.ash }}><span>миття вікон ({windowArea} м²)</span><span>+{calc.windowsSum} ₴</span></div>}
          <div className="flex justify-between items-baseline mt-3"><span className="text-sm" style={{ ...body, color: C.ink }}>Орієнтовно до сплати</span><span className="text-3xl" style={{ ...display, color: C.ink, fontWeight: 700 }}>{calc.total} ₴</span></div>
          <p className="text-xs mt-2" style={{ ...body, color: C.ash }}>{calc.isMinApplied ? `Розрахунок за площею нижчий за мінімальне замовлення (${MIN_ORDER} ₴ — вартість виїзду бригади), тож базова сума саме така.` : `Сума за площею перевищує мінімальне замовлення — мінімалка окремо не додається.`}</p>
        </div>
        <button className="w-full mt-6 py-3.5 rounded-full text-sm font-semibold" style={{ ...body, background: C.ink, color: C.bg }}>Залишити заявку за цим розрахунком</button>
        <p className="text-xs text-center mt-3" style={{ ...body, color: C.ash }}>Точну суму підтвердимо після огляду об'єкта</p>
      </div>
    </div>
  );
}

