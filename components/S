export function OrderChatWidget() {
  const [step, setStep] = useState(0);
  const [messages, setMessages] = useState([
    { from: "bot", text: "Привіт! Це «чисто.» — клінінг Миколаїв. Допоможу замовити прибирання квартири чи іншу послугу за 30 секунд 👋" },
    { from: "bot", text: "Яку послугу вас цікавить?" },
  ]);
  const [answers, setAnswers] = useState({});
  const [area, setArea] = useState(50);
  const [level, setLevel] = useState(3);
  const [date, setDate] = useState("");
  const [name, setName] = useState("");
  const [phone, setPhone] = useState("");
  const endRef = useRef(null);

  useEffect(() => {
    endRef.current?.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }, [messages]);

  const addUser = (text) => setMessages((m) => [...m, { from: "user", text }]);
  const addBot = (text) => setMessages((m) => [...m, { from: "bot", text }]);

  function chooseService(s) {
    setAnswers((a) => ({ ...a, serviceId: s.id, serviceName: s.name, priceOnRequest: !!s.priceOnRequest }));
    addUser(s.name);
    if (s.priceOnRequest) {
      addBot(`Добре, «${s.name}». Скільки приблизно предметів (диванів/крісел/килимів)?`);
      setArea(2);
    } else {
      addBot(`Добре, «${s.name}». Яка орієнтовна площа?`);
      setArea(s.areaDefault);
    }
    setStep(1);
  }

  function confirmArea() {
    const svc = SERVICES.find((s) => s.id === answers.serviceId);
    addUser(svc.priceOnRequest ? `${area} шт.` : `${area} ${svc.unit}`);
    if (svc.priceOnRequest) {
      addBot("Зрозуміло. Коли вам зручно?");
      setStep(3);
    } else {
      addBot("Оцініть, будь ласка, ступінь забруднення від 1 до 5");
      setStep(2);
    }
  }

  function chooseLevel(lv) {
    setLevel(lv);
    addUser(`${lv}`);
    const svc = SERVICES.find((s) => s.id === answers.serviceId);
    const rate = rateForLevel(svc, lv);
    const total = Math.max(MIN_ORDER, Math.round(area * rate));
    setAnswers((a) => ({ ...a, level: lv, estimate: total }));
    addBot(`Орієнтовно: ${total} ₴ (фінальну суму підтвердить майстер на місці). Коли вам зручно?`);
    setStep(3);
  }

  function confirmDate() {
    addUser(date || "уточнимо телефоном");
    addBot("Як до вас звертатися і на який номер передзвонити?");
    setStep(4);
  }

  function confirmContact() {
    addUser(`${name}, ${phone}`);
    addBot("Дякуємо! Перевірте заявку нижче і підтвердіть відправку 👇");
    setAnswers((a) => ({ ...a, date, name, phone }));
    setStep(5);
  }

  function submit() {
    addUser("Надіслати заявку");
    addBot("✅ Заявку прийнято! Передзвонимо протягом 15 хвилин.");
    setStep(6);
  }

  const svc = SERVICES.find((s) => s.id === answers.serviceId);

  return (
    <div className="rounded-2xl overflow-hidden max-w-lg mx-auto" style={{ background: C.white }}>
      <div className="p-5 flex items-center gap-2.5" style={{ background: C.ink }}>
        <div className="w-8 h-8 rounded-full flex items-center justify-center" style={{ background: C.lemon }}>
          <MessageCircle size={16} color={C.ink} strokeWidth={2.25} />
        </div>
        <div>
          <div className="text-sm font-semibold" style={{ ...body, color: C.bg }}>Заявка «чисто.»</div>
          <div className="text-xs" style={{ ...body, color: C.mint }}>онлайн, відповідає одразу</div>
        </div>
      </div>

      <div className="p-5 max-h-96 overflow-y-auto flex flex-col gap-2.5">
        {messages.map((m, i) => (
          <div key={i} className={`flex ${m.from === "user" ? "justify-end" : "justify-start"}`}>
            <div
              className="px-4 py-2.5 rounded-2xl text-sm max-w-[80%]"
              style={{
                ...body,
                background: m.from === "user" ? C.lemon : C.bgSoft,
                color: C.ink,
                borderBottomRightRadius: m.from === "user" ? 4 : 16,
                borderBottomLeftRadius: m.from === "bot" ? 4 : 16,
              }}
            >
              {m.text}
            </div>
          </div>
        ))}
        <div ref={endRef} />
      </div>

      <div className="p-5 border-t" style={{ borderColor: C.bgSoft }}>
        {step === 0 && (
          <div className="flex flex-wrap gap-2">
            {SERVICES.map((s) => (
              <button key={s.id} onClick={() => chooseService(s)} className="px-3.5 py-2 rounded-full text-sm font-medium" style={{ ...body, background: C.bgSoft, color: C.ink }}>
                {s.name}
              </button>
            ))}
          </div>
        )}

        {step === 1 && svc && (
          <div>
            <label className="flex justify-between text-xs uppercase tracking-wide mb-2" style={{ ...body, color: C.ash }}>
              <span>{svc.priceOnRequest ? "Кількість предметів" : "Площа"}</span>
              <span style={mono}>{area} {svc.priceOnRequest ? "шт." : svc.unit}</span>
            </label>
            <input
              type="range"
              min={svc.priceOnRequest ? 1 : svc.areaMin}
              max={svc.priceOnRequest ? 10 : svc.areaMax}
              value={area}
              onChange={(e) => setArea(Number(e.target.value))}
              className="range-slider w-full mb-4"
            />
            <button onClick={confirmArea} className="w-full py-3 rounded-full text-sm font-semibold" style={{ ...body, background: C.ink, color: C.bg }}>Далі</button>
          </div>
        )}

        {step === 2 && (
          <div className="flex gap-2">
            {[1, 2, 3, 4, 5].map((lv) => (
              <button key={lv} onClick={() => chooseLevel(lv)} className="flex-1 py-2.5 rounded-lg text-sm font-semibold" style={{ ...mono, background: C.bgSoft, color: C.ink }}>{lv}</button>
            ))}
          </div>
        )}

        {step === 3 && (
          <div>
            <input
              type="date"
              value={date}
              onChange={(e) => setDate(e.target.value)}
              className="w-full px-4 py-2.5 rounded-lg text-sm mb-3"
              style={{ ...body, background: C.bgSoft, color: C.ink, border: "none" }}
            />
            <button onClick={confirmDate} className="w-full py-3 rounded-full text-sm font-semibold" style={{ ...body, background: C.ink, color: C.bg }}>Далі</button>
          </div>
        )}

        {step === 4 && (
          <div className="flex flex-col gap-2.5">
            <input type="text" placeholder="Ваше ім'я" value={name} onChange={(e) => setName(e.target.value)} className="w-full px-4 py-2.5 rounded-lg text-sm" style={{ ...body, background: C.bgSoft, color: C.ink, border: "none" }} />
            <input type="tel" placeholder="+380 __ ___ __ __" value={phone} onChange={(e) => setPhone(e.target.value)} className="w-full px-4 py-2.5 rounded-lg text-sm" style={{ ...body, background: C.bgSoft, color: C.ink, border: "none" }} />
            <button onClick={confirmContact} disabled={!name || !phone} className="w-full py-3 rounded-full text-sm font-semibold" style={{ ...body, background: C.ink, color: C.bg, opacity: !name || !phone ? 0.5 : 1 }}>Далі</button>
          </div>
        )}

        {step === 5 && (
          <div>
            <div className="rounded-lg p-4 mb-3 text-sm" style={{ background: C.mintSoft, ...body, color: C.inkSoft }}>
              <div><b>Послуга:</b> {answers.serviceName}</div>
              {!answers.priceOnRequest && <div><b>Орієнтовна ціна:</b> {answers.estimate} ₴</div>}
              <div><b>Дата:</b> {date || "уточнимо телефоном"}</div>
              <div><b>Контакт:</b> {name}, {phone}</div>
            </div>
            <button onClick={submit} className="w-full py-3 rounded-full text-sm font-semibold" style={{ ...body, background: C.lemon, color: C.ink }}>Надіслати заявку</button>
          </div>
        )}

        {step === 6 && (
          <div className="flex items-center gap-2 justify-center py-2" style={{ ...body, color: C.iconVivid }}>
            <CheckCircle2 size={18} strokeWidth={2.25} /> Заявку надіслано
          </div>
        )}
      </div>
    </div>
  );
}

